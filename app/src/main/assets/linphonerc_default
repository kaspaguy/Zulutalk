
## Start of default rc

[sip]
contact="ZuluTalk Android" <sip:zulutalk.android@unknown-host>
use_ipv6=1
keepalive_period=30000
sip_port=-1
sip_tcp_port=-1
sip_tls_port=-1
media_encryption=none
update_presence_model_timestamp_before_publish_expires_refresh=1
use_rfc2833=1
use_info=1

[net]
#Because dynamic bitrate adaption can increase bitrate, we must allow "no limit"
download_bw=0
upload_bw=0

[video]
size=vga
automatically_accept=1
automatically_initiate=0
automatically_accept_direction=3

[app]
tunnel=disabled
keep_service_alive=1
route_audio_to_speaker_when_video_enabled=1
auto_download_incoming_voice_recordings=1
auto_download_incoming_icalendars=1

[tunnel]
host=
port=443

[misc]
max_calls=10
history_max_size=100
conference_layout=1
hide_empty_chat_rooms=1

[fec]
fec_enabled=1

[magic_search]
return_empty_friends=1

[chat]
imdn_to_everybody_threshold=1

[ui]
contacts_filter=*
disable_chat_feature=1
disable_meetings_feature=1
disable_call_recordings_feature=1
automatically_show_dialpad=1
assistant_hide_create_account=1
assistant_third_party_sip_account_domain=sip.zulutalk.com
assistant_third_party_sip_account_transport=tls

## End of default rc
